{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023"],
        "types": ["node"],

        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,

        "strict": true,
        "skipLibCheck": true
    },
    "include": ["vite.config.ts"]
}
